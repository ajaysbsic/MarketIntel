# Using standard Python image
FROM python:3.11-slim

WORKDIR /app

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY src/ src/
COPY config_keyword_monitor.production.json config_keyword_monitor.json
COPY tech_keywords.json tech_keywords.json

# Create logs directory
RUN mkdir -p logs

# Set Python path so src modules can be imported
ENV PYTHONPATH=/app/src

# Run the keyword monitor watcher
CMD ["python", "src/keyword_monitor_watcher.py"]
