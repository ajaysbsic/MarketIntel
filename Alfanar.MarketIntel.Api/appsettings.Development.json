{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "System": "Information"
    }
  },
  "WebSocketsEnabled": "true",
  "ConnectionStrings": {
    "Default": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=MarketIntel_Dev;Integrated Security=True;TrustServerCertificate=True"
  },
  
  "ApiSettings": {
    "MaxIngestBatchSize": 50,
    "DefaultPageSize": 10,
    "MaxPageSize": 50,
    "EnableDuplicateDetection": true,
    "DuplicateCheckWindowDays": 7
  },
  
  "GoogleAI": {
    "ApiKey": "YOUR_GOOGLE_API_KEY_HERE",
    "Model": "gemini-2.5-flash",
    "MaxTokens": 1500,
    "Temperature": 0.3,
    "EnableAiSummarization": true,
    "EnableSentimentAnalysis": true,
    "TimeoutSeconds": 30,
    "EnableCaching": false,
    "EnableStreaming": true,
    "PromptTemplate": {
      "Default": "",
      "Financial": "",
      "Technical": ""
    }
  },

  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-4o-mini",
    "MaxTokens": 1500,
    "Temperature": 0.3,
    "EnableAiCategorization": true,
    "FallbackToRuleBasedClassifier": true,
    "TimeoutSeconds": 30
  },

  "AI": {
  "DefaultProvider": "gemini"
  },
  
  "GoogleSearch": {
    "ApiKey": "YOUR_GOOGLE_SEARCH_API_KEY_HERE",
    "SearchEngineId": "YOUR_SEARCH_ENGINE_ID_HERE",
    "MaxResultsPerRequest": 10,
    "EnableCaching": true,
    "CacheExpirationHours": 24
  },

  "NewsApi": {
    "ApiKey": "YOUR_NEWSAPI_KEY_HERE",
    "EnableCaching": true,
    "CacheExpirationHours": 6
  },

  "KeywordMonitoring": {
    "DefaultCheckIntervalMinutes": 60,
    "MaxMonitorsPerUser": 50,
    "EnableNotifications": true
  },

  "CompetitorTracking": {
    "AutoDetect": true,
    "ScanOnIngestion": true
  },

  "Alerts": {
    "EnableArticleAlerts": true,
    "AiConfirmation": true
  },
  "AiChat": {
    "EnableLiveWebSearch": true,
    "WebSearchTimeoutMs": 3000,
    "WebSearchResultsCacheMinutes": 5,
    "MaxWebResultsPerQuery": 5
  },

  "Trends": {
    "SnapshotTime": "00:00"
  },
  "Hangfire": {
    "Enabled": true,
    "WorkerCount": 3,
    "HistoryRetentionDays": 30,
    "DashboardEnabled": true
  },
  "Jobs": {
    "RssPoller": {
      "CronExpression": "*/5 * * * *",
      "Enabled": true
    },
    "KeywordMonitor": {
      "CronExpression": "*/5 * * * *",
      "Enabled": true
    },
    "TrendSnapshot": {
      "CronExpression": "0 0 * * *",
      "Enabled": true
    },
    "AlertProcessing": {
      "CronExpression": "*/1 * * * *",
      "Enabled": true
    },
    "NotificationQueue": {
      "CronExpression": "*/1 * * * *",
      "Enabled": true
    }
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "${Email_Username}",
    "Password": "${Email_Password}",
    "FromAddress": "alerts@alfanar.com",
    "Enabled": true
  },
  "Notifications": {
    "MaxRetries": 3,
    "RetryDelaySeconds": 300
  },

  "ReportGeneration": {
    "PdfStoragePath": "wwwroot/reports",
    "MaxReportResults": 1000,
    "RetentionDays": 90
  },
  
  "RssFeedManagement": {
    "DefaultPollIntervalMinutes": 5,
    "MaxConcurrentFeeds": 3,
    "RequestTimeoutSeconds": 20,
    "EnableETagSupport": true,
    "UserAgent": "MarketIntelBot-Dev/1.0"
  },
  
  "CategoryClassification": {
    "DefaultCategory": "General",
    "MinimumConfidenceScore": 0.5,
    "EnableMultiCategoryTagging": true,
    "MaxTagsPerArticle": 15
  },
  
  "FileStorage": {
    "BasePath": "storage/reports",
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".ppt", ".pptx"],
    "EnableCompression": false
  },
  
  "AzureStorage": {
    "UseAzureBlobStorage": true,
    "ConnectionString": "YOUR_AZURE_STORAGE_CONNECTION_STRING",
    "ContainerName": "intelligence-reports"
  },
  
  "ReportProcessing": {
    "EnableAutoAnalysis": true,
    "AnalysisDelaySeconds": 2,
    "MaxRetries": 3,
    "EnableOcr": false,
    "OcrLanguage": "eng"
  },
  
  "Features": {
    "EnableSignalRNotifications": true,
    "EnableAutoTagging": true,
    "EnableSentimentAnalysis": true,
    "EnableContentSummarization": true,
    "EnableFinancialReports": true
  },
  
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  }
}
